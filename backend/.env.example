# Variables de entorno del backend — copiar a .env y completar con valores reales.
# NUNCA commitear .env (está en .gitignore). Este archivo NO debe contener secretos reales.

NODE_ENV=development
PORT=3000

# Supabase — dashboard > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# SECRETO — solo backend. Jamás en el frontend ni en variables VITE_ (SECURITY.md R5).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Proveedor de IA (opcional en Fase 0)
AI_API_KEY=

# CORS — origen permitido del frontend
FRONTEND_URL=http://localhost:5173

# Solo local: si Node falla con UNABLE_TO_VERIFY_LEAF_SIGNATURE (antivirus HTTPS)
# ALLOW_INSECURE_TLS=true

# Solo local: registro sin enviar correo (evita rate limit Confirm email)
# DEV_AUTO_CONFIRM_REGISTER=true

# Microsoft Entra / Teams OAuth (opcional). Sin estos valores el wizard usa datos de demostración.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=http://localhost:5173/onboarding
